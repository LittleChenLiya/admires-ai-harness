# Offline mode is the secure default. No key is required.
ADMIRE_MODEL_PROVIDER=mock
ADMIRE_DATABASE_PATH=.admire/harness.db
ADMIRE_WORKSPACE_ROOT=.admire/workspaces
ADMIRE_WEB_DIST=web/dist
ADMIRE_ALLOW_NETWORK=false

# Opt in to an OpenAI-compatible endpoint. Never commit a real key.
# ADMIRE_MODEL_PROVIDER=openai-compatible
# ADMIRE_MODEL_BASE_URL=https://api.openai.com/v1
# ADMIRE_MODEL_NAME=gpt-4.1-mini
# ADMIRE_MODEL_API_KEY=
